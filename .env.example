# .env.example  [Names of secrets, never real values]
# Copy to .env (gitignored) and fill in. Never commit .env or share your login.

# Your personal read-only connection to the group database (Miguel sends it to you).
# Leave it empty to read data/processed/bond_month_panel.parquet instead.
ML2_DB_URL=

# --- Data admin only (the loader in pipeline/) -------------------------------
# Source database, read-only role.
LAKE_DB_URL=postgresql+psycopg2://<user>:<password>@<source-host>:5432/<db>
# Target: the group database the loader writes to (owner role). Inside docker compose the host is "groupdb".
GROUP_DB_URL=postgresql+psycopg2://ml2_admin:<password>@groupdb:5432/ml2
# Admin URL used by scripts/add_member.py from this machine (host port 5433).
GROUP_DB_ADMIN_URL=postgresql+psycopg2://ml2_admin:<password>@localhost:5433/ml2
# Local Postgres container (docker-compose.yml)
GROUP_DB_ADMIN_USER=ml2_admin
GROUP_DB_ADMIN_PASSWORD=
GROUP_DB_BIND=127.0.0.1
GROUP_DB_PORT=5433
